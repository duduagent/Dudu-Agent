# Konfigurasi provider AI (kompatibel OpenAI Chat Completions).
#
# MODE WEB / DEVELOPMENT (npm run server): salin file ini menjadi `.env` di akar proyek.
# APLIKASI DESKTOP: jangan pakai file ini. Buka menu "Dudu AI → Buka folder konfigurasi";
#   aplikasi membuat `dudu.env` di folder data pengguna. Isinya sama dengan di bawah.
#
# Jangan pernah meng-commit atau membagikan file yang berisi kunci API.
# Nilai environment variable sistem menimpa nilai di file.

# Wajib: kunci API milik Anda sendiri dari penyedia model.
DUDU_PROVIDER_API_KEY=

# Alamat dasar API (tanpa /chat/completions) dan nama model; sesuaikan dengan akun provider Anda.
DUDU_PROVIDER_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DUDU_MODEL=glm-4-flash

# --- Kemampuan multimodal (opsional; aktif HANYA bila diisi — tidak ada tebakan model otomatis) ---
# Vision: model yang menerima gambar dalam format OpenAI "image_url". Endpoint/kunci default = provider chat.
# DUDU_VISION_MODEL=
# DUDU_VISION_BASE_URL=
# DUDU_VISION_API_KEY=
# Transkripsi audio: endpoint kompatibel OpenAI /audio/transcriptions.
# DUDU_STT_MODEL=
# DUDU_STT_BASE_URL=
# DUDU_STT_API_KEY=

# Batas ukuran unggahan per file (MB, 1–200, bawaan 25).
# DUDU_MAX_UPLOAD_MB=25

# Hanya mode web/development: folder data (file, indeks KB, misi, artefak). Bawaan ./.dudu-data
# DUDU_DATA_DIR=.dudu-data

# Hanya mode web/development (server HTTP lokal, selalu diikat ke 127.0.0.1). Tidak dipakai aplikasi desktop.
PORT=8787

# Opsional: batas waktu menunggu provider, dalam milidetik (minimum 1000, bawaan 30000).
# DUDU_TIMEOUT_MS=30000
