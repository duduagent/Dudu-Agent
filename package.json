{
  "name": "dudu-workspace",
  "productName": "Dudu AI",
  "description": "Dudu AI — asisten AI pribadi (aplikasi desktop dan web)",
  "private": true,
  "version": "0.6.4",
  "type": "module",
  "main": "electron/main.mjs",
  "bin": {
    "dudu": "server/cli.mjs"
  },
  "author": "Dudu AI",
  "homepage": "https://example.com/dudu-ai",
  "desktopName": "dudu-ai.desktop",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port 5174",
    "server": "node server/chat-server.mjs",
    "cli": "node server/cli.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "icon": "electron scripts/render-icon.cjs",
    "verify": "npm run typecheck && npm run check:imports && npm test && npm run build",
    "check:imports": "node scripts/check-server-imports.mjs",
    "audit:prod": "npm audit --omit=dev",
    "verify:release": "node scripts/verify-release.mjs",
    "landing:dev": "node scripts/landing-server.mjs",
    "landing:check": "node scripts/check-landing.mjs",
    "landing:check:strict": "node scripts/check-landing.mjs --strict",
    "verify:ui": "node scripts/verify-ui.mjs",
    "smoke:provider": "node scripts/provider-smoke.mjs",
    "package:release": "node scripts/package-release.mjs",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --x64 --arm64"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "unpdf": "^1.9.0"
  }
}
